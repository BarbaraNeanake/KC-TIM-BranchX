# Supabase (PostgreSQL) — ambil dari Supabase > Connect > ORMs > Prisma.
# Runtime app: transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrasi: session pooler (port 5432)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Login (v1): password bersama per role. Ganti dengan password kuat.
ADMIN_PASSWORD="ganti-password-admin"
VIEWER_PASSWORD="ganti-password-viewer"
# Kunci tanda tangan cookie sesi, minimal 32 karakter acak.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
